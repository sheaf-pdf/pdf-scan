# Shell scripts, should any be tracked, keep LF: bash, on a Windows
# checkout too, can't run a script with CRs in it.
*.sh text eol=lf

# Images and PDFs are bytes: a checkout mustn't touch their line endings.
*.png binary
*.tif binary
*.tiff binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.webp binary
*.pdf binary
*.pbm binary
*.pgm binary
*.ppm binary
*.pnm binary
